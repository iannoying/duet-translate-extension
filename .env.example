# Runtime URLs/domains for the extension's own backend.
# Development falls back to localhost values. A production build fails unless
# all four are set, so nothing ships pointing at a server we do not run.
# Values must already be canonical:
# - URLs must not end with a trailing slash
# - origins/domains are comma-separated with no spaces
#
# WXT_API_URL=https://api.duettranslate.com
# WXT_WEBSITE_URL=https://duettranslate.com
# WXT_OFFICIAL_SITE_ORIGINS=https://duettranslate.com,https://www.duettranslate.com
# WXT_AUTH_COOKIE_DOMAINS=duettranslate.com
#
# Required in production:
# WXT_GOOGLE_CLIENT_ID=your-google-client-id
#
# Optional analytics (off unless both are set):
# WXT_POSTHOG_HOST=https://us.i.posthog.com
# WXT_POSTHOG_API_KEY=phc_your_posthog_key
# WXT_ANALYTICS_DAILY_FEATURE_CACHE_ENABLED=false
